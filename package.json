{
  "name": "@open-elements/ui",
  "version": "0.9.0",
  "description": "Shared UI component library for Open Elements applications",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenElementsLabs/open-elements-ui.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles/brand.css": "./dist/brand.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run build:css",
    "build:css": "cp src/styles/brand.css dist/brand.css",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint src/ stories/ .storybook/",
    "format": "prettier --write src/ stories/ .storybook/",
    "format:check": "prettier --check src/ stories/ .storybook/",
    "typecheck": "tsc --noEmit",
    "sbom": "node scripts/generate-sbom.mjs",
    "sbom:verify": "node scripts/verify-sbom.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tiptap/core": "^3.22.0",
    "@tiptap/extension-list": "^3.22.0",
    "@tiptap/extension-placeholder": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "react-day-picker": "^9.14.0",
    "tailwind-merge": "^3.0.0",
    "tiptap-markdown": "^0.9.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.3.0",
    "lucide-react": "^0.500.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@cyclonedx/cyclonedx-library": "^10.2.0",
    "@eslint/js": "^9.0.0",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.500.0",
    "prettier": "^3.0.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.2",
    "vitest": "^3.0.0"
  }
}
